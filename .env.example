# Set these in your hosting dashboard; Node does not auto-load this file.
APP_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
# AI is optional. Set both values to enable the Analyze button.
OPENAI_API_KEY=
OPENAI_MODEL=
# Only local development uses false; HTTPS deployments must use true.
COOKIE_SECURE=true
PORT=3000
